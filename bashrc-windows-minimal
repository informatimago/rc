# PATH / MANPATH / INFOPATH are rebuilt deterministically with shell-only
# existence tests.  This avoids repeated prepending and avoids forks.
__pjb_path_seen=
__pjb_manpath_seen=
__pjb_infopath_seen=
__pjb_path_parts=()
__pjb_manpath_parts=()
__pjb_infopath_parts=()

pjb_path_add() {
    local d
    for d in "$@" ; do
        [ -d "$d" ] || continue
        case ":$__pjb_path_seen:" in
            *":$d:"*) ;;
            *)
                __pjb_path_seen="${__pjb_path_seen}:$d"
                __pjb_path_parts+=("$d")
                ;;
        esac
    done
}

pjb_manpath_add() {
    local d
    for d in "$@" ; do
        [ -d "$d" ] || continue
        case ":$__pjb_manpath_seen:" in
            *":$d:"*) ;;
            *)
                __pjb_manpath_seen="${__pjb_manpath_seen}:$d"
                __pjb_manpath_parts+=("$d")
                ;;
        esac
    done
}

pjb_infopath_add() {
    local d
    for d in "$@" ; do
        [ -d "$d" ] || continue
        case ":$__pjb_infopath_seen:" in
            *":$d:"*) ;;
            *)
                __pjb_infopath_seen="${__pjb_infopath_seen}:$d"
                __pjb_infopath_parts+=("$d")
                ;;
        esac
    done
}

pjb_join_colon() {
    local IFS=:
    printf '%s' "$*"
}

# User layer.
