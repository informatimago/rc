    "/c/Users/${USERNAME:-$USER}/.local/bin" \
    "/c/msys64/home/${USERNAME:-$USER}/bin/"

PATH="$(pjb_join_colon "${__pjb_path_parts[@]}")"
export PATH

if [ "${#__pjb_manpath_parts[@]}" -gt 0 ] ; then
    MANPATH="$(pjb_join_colon "${__pjb_manpath_parts[@]}")"
    export MANPATH
fi

if [ "${#__pjb_infopath_parts[@]}" -gt 0 ] ; then
    INFOPATH="$(pjb_join_colon "${__pjb_infopath_parts[@]}")"
    export INFOPATH
fi

unset __pjb_path_seen __pjb_manpath_seen __pjb_infopath_seen
unset __pjb_path_parts __pjb_manpath_parts __pjb_infopath_parts
unset -f pjb_path_add pjb_manpath_add pjb_infopath_add pjb_join_colon

