# Base MSYS2 system layer.
pjb_path_add /usr/bin /bin /usr/sbin /sbin
pjb_manpath_add /usr/share/man /usr/man
pjb_infopath_add /usr/share/info

# Native Windows tools.
pjb_path_add \
