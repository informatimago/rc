# Lightweight helpers that do not need startup-time subprocesses.
rehash() { hash -r; }

ds() {
    local i=1
    local dir
    for dir in "${DIRSTACK[@]}" ; do
        printf '%2d) %s\n' "$i" "$dir"
        i=$((i + 1))
    done
}

cdd() {
    local diri
    local i=1
    local dir
    ds
    read -r -p 'Change to what directory? ' diri
    for dir in "${DIRSTACK[@]}" ; do
        if [ "$diri" = "$i" ] ; then
            cd "$dir" || return
            return
        fi
        i=$((i + 1))
    done
    cd "$diri" || return
}

pushdd() {
    local diri
    local i=1
    local dir
    ds
    read -r -p 'Change to what directory? ' diri
    for dir in "${DIRSTACK[@]}" ; do
        if [ "$diri" = "$i" ] ; then
            pushd "$dir" >/dev/null || return
            return
        fi
        i=$((i + 1))
    done
    pushd "$diri" >/dev/null || return
}

